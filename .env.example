# Application Configuration
APP_NAME=EVE Healthcare Diagnostic Service
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1

# Security
# IMPORTANT: Replace with a secure random string (>= 32 bytes) before deploying
SECRET_KEY=change_this_in_production_to_a_secure_random_secret_key_32_bytes_min
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Database — individual components (used by docker-compose and the app to build DATABASE_URL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=eve_user
POSTGRES_PASSWORD=eve_password
POSTGRES_DB=eve_healthcare

# Full connection URL (assembled from the components above; override if needed)
DATABASE_URL=postgresql://eve_user:eve_password@localhost:5432/eve_healthcare

# Test Database — SQLite in-memory keeps tests fast and dependency-free
TEST_DATABASE_URL=sqlite:///./test.db

# Logging
LOG_LEVEL=INFO
